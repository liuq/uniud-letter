% Visibilita' del footer della prima pagina. Il branding corporate resta
% separato dal blocco dei riferimenti, cosi' e' possibile lasciare i marchi
% ufficiali ma sopprimere completamente dati e contatti.
\def\uniud@footerprimapagina{true}
\def\uniud@footermarchio{true}
\def\uniud@footercertificazioni{true}
\def\uniud@footerriferimenti{true}
\def\uniud@footerresponsabile{true}
\def\uniud@footercompilatore{true}
\def\uniud@footerindirizzo{true}
\def\uniud@footertelefono{true}
\def\uniud@footerfax{true}
\def\uniud@footeremail{true}
\def\uniud@footersito{true}
\def\uniud@footercfpiva{true}
\def\uniud@footerabi{false}
\def\uniud@footercab{false}
\def\uniud@footercin{false}
\def\uniud@footerconto{false}

\newcommand*{\uniudsetfooterprimapagina}[1]{\gdef\uniud@footerprimapagina{#1}}
\newcommand*{\uniudsetfootermarchio}[1]{\gdef\uniud@footermarchio{#1}}
\newcommand*{\uniudsetfootercertificazioni}[1]{\gdef\uniud@footercertificazioni{#1}}
\newcommand*{\uniudsetfooterriferimenti}[1]{\gdef\uniud@footerriferimenti{#1}}
\newcommand*{\uniudsetfooterresponsabile}[1]{\gdef\uniud@footerresponsabile{#1}}
\newcommand*{\uniudsetfootercompilatore}[1]{\gdef\uniud@footercompilatore{#1}}
\newcommand*{\uniudsetfooterindirizzo}[1]{\gdef\uniud@footerindirizzo{#1}}
\newcommand*{\uniudsetfootertelefono}[1]{\gdef\uniud@footertelefono{#1}}
\newcommand*{\uniudsetfooterfax}[1]{\gdef\uniud@footerfax{#1}}
\newcommand*{\uniudsetfooteremail}[1]{\gdef\uniud@footeremail{#1}}
\newcommand*{\uniudsetfootersito}[1]{\gdef\uniud@footersito{#1}}
