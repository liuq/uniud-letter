\input{uniudletter-version.tex}
\ProvidesFile{uniud.lco}[2026/08/26 v\UniudLetterVersion\space UNIUD letterhead 2026]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{geometry}
\RequirePackage{lastpage}
\usetikzlibrary{calc}

\makeatletter

\definecolor{uniudblue}{HTML}{0000FF}

% Asset self-contained: il pacchetto distribuisce il solo sigillo blu necessario
% alla carta intestata. Il file SVG sorgente e il PDF runtime sono inclusi nella
% distribuzione; vedere NOTICE per provenienza e diritti sul marchio UNIUD.
\newcommand*{\uniud@includeseal}[1][]{%
  \IfFileExists{uniud-sigillo-blu.pdf}{%
    \includegraphics[#1]{uniud-sigillo-blu.pdf}%
  }{%
    \PackageError{uniud}{Asset interno 'uniud-sigillo-blu.pdf' non trovato}{Reinstallare il pacchetto uniudletter completo.}%
  }%
}

% Altri asset corporate estratti dal modello DOTX ufficiale 2025/2026.
% Sono inclusi nel pacchetto per mantenere l'installazione self-contained.
\newcommand*{\uniud@includeasset}[2][]{%
  \IfFileExists{#2}{%
    \includegraphics[#1]{#2}%
  }{%
    \PackageError{uniud}{Asset interno '#2' non trovato}{Reinstallare il pacchetto uniudletter completo.}%
  }%
}

\IfFontExistsTF{Work Sans}{
  \setmainfont{Work Sans}[Ligatures=TeX]
  \setsansfont{Work Sans}[Ligatures=TeX]
}{
  \IfFontExistsTF{Helvetica Neue}{
    \setmainfont{Helvetica Neue}[Ligatures=TeX]
    \setsansfont{Helvetica Neue}[Ligatures=TeX]
    \PackageWarningNoLine{uniud}
      {Work Sans non trovato; uso Helvetica Neue}
  }{
    \IfFontExistsTF{Helvetica}{
      \setmainfont{Helvetica}[Ligatures=TeX]
      \setsansfont{Helvetica}[Ligatures=TeX]
      \PackageWarningNoLine{uniud}
        {Work Sans non trovato; uso Helvetica}
    }{
      \setmainfont{TeX Gyre Heros}[Ligatures=TeX]
      \setsansfont{TeX Gyre Heros}[Ligatures=TeX]
      \PackageWarningNoLine{uniud}
        {Work Sans/Helvetica non trovati; uso TeX Gyre Heros}
    }
  }
}

% Tipografia dei blocchi di intestazione (Manuale di identita' visiva 2026,
% sezione 2.2, tavola 071): Circular Bold 8/8 pt per il blocco struttura/sito
% e Circular Book 8/8 pt per il blocco indirizzo. Il DOTX ufficiale usa Work Sans
% per i campi modificabili; lo manteniamo esclusivamente come fallback quando
% Circular non e' installato.
\newif\ifuniud@circular
\uniud@circularfalse
\IfFontExistsTF{Circular Std Book}{%
  \newfontfamily\uniudheaderbook{Circular Std Book}[Ligatures=TeX]
  \IfFontExistsTF{Circular Std Bold}{%
    \newfontfamily\uniudheaderbold{Circular Std Bold}[Ligatures=TeX]
  }{\newfontfamily\uniudheaderbold{Circular Std Book}[Ligatures=TeX,FakeBold=2]}%
  \uniud@circulartrue
}{%
  \IfFontExistsTF{LL Circular Book}{%
    \newfontfamily\uniudheaderbook{LL Circular Book}[Ligatures=TeX]
    \IfFontExistsTF{LL Circular Bold}{%
      \newfontfamily\uniudheaderbold{LL Circular Bold}[Ligatures=TeX]
    }{\newfontfamily\uniudheaderbold{LL Circular Book}[Ligatures=TeX,FakeBold=2]}%
    \uniud@circulartrue
  }{%
    \IfFontExistsTF{Work Sans}{%
      \newfontfamily\uniudheaderbook{Work Sans}[Ligatures=TeX]
      \IfFontExistsTF{Work Sans SemiBold}{%
        \newfontfamily\uniudheaderbold{Work Sans SemiBold}[Ligatures=TeX]
      }{\newfontfamily\uniudheaderbold{Work Sans}[Ligatures=TeX,FakeBold=2]}%
    }{%
      \newcommand*{\uniudheaderbook}{\sffamily}%
      \newcommand*{\uniudheaderbold}{\sffamily\bfseries}%
    }%
    \PackageWarningNoLine{uniud}{LL Circular non trovato. I blocchi dell'intestazione usano il fallback d'ufficio; installare Circular per la resa tipografica esatta del manuale}%
  }%
}
% Font dell'acronimo dipartimentale. Il campione ufficiale del marchio
% dipartimentale e' visivamente meno pesante del Gotham Black usato nel
% wordmark UNIUD. Privilegiamo quindi Gotham Bold e, come fallback d'ufficio,
% Work Sans SemiBold/Bold. Helvetica-like resta l'ultimo fallback prima del
% sans generico.
\IfFontExistsTF{Gotham Bold}{%
  \newfontfamily\uniudacronymfont{Gotham Bold}[Ligatures=TeX]
}{%
  \IfFontExistsTF{Gotham Medium}{%
    \newfontfamily\uniudacronymfont{Gotham Medium}[Ligatures=TeX]
  }{%
    \IfFontExistsTF{Work Sans SemiBold}{%
      \newfontfamily\uniudacronymfont{Work Sans SemiBold}[Ligatures=TeX]
    }{%
      \IfFontExistsTF{Work Sans Bold}{%
        \newfontfamily\uniudacronymfont{Work Sans Bold}[Ligatures=TeX]
      }{%
        \IfFontExistsTF{Work Sans}{%
          \newfontfamily\uniudacronymfont{Work Sans}[Ligatures=TeX,FakeBold=1.5]
        }{%
          \IfFontExistsTF{Helvetica Neue Bold}{%
            \newfontfamily\uniudacronymfont{Helvetica Neue Bold}[Ligatures=TeX]
          }{%
            \IfFontExistsTF{Helvetica Neue}{%
              \newfontfamily\uniudacronymfont{Helvetica Neue}[Ligatures=TeX,FakeBold=1.5]
            }{%
              \IfFontExistsTF{TeX Gyre Heros}{%
                \newfontfamily\uniudacronymfont{TeX Gyre Heros}[Ligatures=TeX,FakeBold=1.5]
              }{%
                \newcommand*{\uniudacronymfont}{\sffamily\bfseries}%
              }%
            }%
          }%
        }%
      }%
    }%
  }%
}

% Il wordmark contratto UNIUD resta invece nel peso Black previsto dal manuale.
\IfFontExistsTF{Gotham Black}{%
  \newfontfamily\uniudwordmarkfont{Gotham Black}[Ligatures=TeX]
}{%
  \IfFontExistsTF{Work Sans Black}{%
    \newfontfamily\uniudwordmarkfont{Work Sans Black}[Ligatures=TeX]
  }{%
    \IfFontExistsTF{Work Sans SemiBold}{%
      \newfontfamily\uniudwordmarkfont{Work Sans SemiBold}[Ligatures=TeX]
    }{%
      \IfFontExistsTF{Work Sans}{%
        \newfontfamily\uniudwordmarkfont{Work Sans}[Ligatures=TeX,FakeBold=3]
      }{%
        \IfFontExistsTF{Helvetica Neue Black}{%
          \newfontfamily\uniudwordmarkfont{Helvetica Neue Black}[Ligatures=TeX]
        }{%
          \IfFontExistsTF{Helvetica Neue Bold}{%
            \newfontfamily\uniudwordmarkfont{Helvetica Neue Bold}[Ligatures=TeX]
          }{%
            \IfFontExistsTF{TeX Gyre Heros}{%
              \newfontfamily\uniudwordmarkfont{TeX Gyre Heros}[Ligatures=TeX,FakeBold=3]
            }{%
              \newcommand*{\uniudwordmarkfont}{\sffamily\bfseries}%
            }%
          }%
        }%
      }%
    }%
  }%
}

