\newcommand*{\uniudsetfootercab}[1]{\gdef\uniud@footercab{#1}}
\newcommand*{\uniudsetfootercin}[1]{\gdef\uniud@footercin{#1}}
\newcommand*{\uniudsetfooterconto}[1]{\gdef\uniud@footerconto{#1}}

% Costruzione di una riga del footer con separatori solo tra gli elementi
% realmente presenti.
\newif\ifuniud@footerrowcontent
\newcommand*{\uniud@footerrowstart}{\uniud@footerrowcontentfalse}
% Spaziature del footer volutamente compatte: il manuale prescrive
% Work Sans Regular 6/7.5 pt. Applichiamo una spaziatura interparola ridotta
% all'intero blocco dei riferimenti (nomi, indirizzo, telefoni, dati fiscali, ecc.)
% senza modificare i glifi o il tracking del font.
\newcommand*{\uniud@footercompactspacing}{%
  \spaceskip=0.18em plus 0.015em minus 0.02em\relax
  \xspaceskip=0.18em plus 0.015em minus 0.02em\relax
}
\newcommand*{\uniud@footerfieldspace}{\hspace{0.14em}}
\newcommand*{\uniud@footerseparator}{\hspace{0.22em}-\hspace{0.22em}}
% Telefono e fax ereditano la stessa spaziatura compatta globale del footer.
\newcommand*{\uniud@footerphonenumber}[1]{#1}
\newcommand*{\uniud@footeritem}[1]{%
  \ifuniud@footerrowcontent\uniud@footerseparator\else\uniud@footerrowcontenttrue\fi#1%
}
\newcommand*{\uniud@footerrowend}{\ifuniud@footerrowcontent\\\fi}

\newcommand*{\uniud@footercontactrow}{%
  \uniud@footerrowstart
  \ifdefstring{\uniud@footerindirizzo}{true}{\Ifkomavarempty{indirizzopiepagina}{}{\uniud@footeritem{\usekomavar{indirizzopiepagina}}}}{}%
  \ifdefstring{\uniud@footertelefono}{true}{\Ifkomavarempty{fromphone}{}{\uniud@footeritem{t\uniud@footerfieldspace\uniud@footerphonenumber{\usekomavar{fromphone}}}}}{}%
  \ifdefstring{\uniud@footerfax}{true}{\Ifkomavarempty{fromfax}{}{\uniud@footeritem{f\uniud@footerfieldspace\uniud@footerphonenumber{\usekomavar{fromfax}}}}}{}%
  \ifdefstring{\uniud@footeremail}{true}{\Ifkomavarempty{fromemail}{}{\uniud@footeritem{\usekomavar{fromemail}}}}{}%
  \ifdefstring{\uniud@footersito}{true}{\Ifkomavarempty{fromurl}{}{\uniud@footeritem{www.\usekomavar{fromurl}}}}{}%
  \uniud@footerrowend
}

\newcommand*{\uniud@footerfiscalrow}{%
  \uniud@footerrowstart
  \ifdefstring{\uniud@footercfpiva}{true}{%
    \Ifkomavarempty{codicefiscale}{}{\uniud@footeritem{CF\uniud@footerfieldspace\usekomavar{codicefiscale}}}%
    \Ifkomavarempty{partitaiva}{}{\uniud@footeritem{P.IVA\uniud@footerfieldspace\usekomavar{partitaiva}}}%
  }{}%
  \ifdefstring{\uniud@footerabi}{true}{\Ifkomavarempty{abi}{}{\uniud@footeritem{ABI\uniud@footerfieldspace\usekomavar{abi}}}}{}%
  \ifdefstring{\uniud@footercab}{true}{\Ifkomavarempty{cab}{}{\uniud@footeritem{CAB\uniud@footerfieldspace\usekomavar{cab}}}}{}%
  \ifdefstring{\uniud@footercin}{true}{\Ifkomavarempty{cin}{}{\uniud@footeritem{CIN\uniud@footerfieldspace\usekomavar{cin}}}}{}%
  \ifdefstring{\uniud@footerconto}{true}{\Ifkomavarempty{contocorrente}{}{\uniud@footeritem{c/c\uniud@footerfieldspace\usekomavar{contocorrente}}}}{}%
  \uniud@footerrowend
}

% Modalita' documentale.
\def\uniud@modalita{digitale}
\newcommand*{\uniuddigitale}{\gdef\uniud@modalita{digitale}}
\newcommand*{\uniudanalogico}{\gdef\uniud@modalita{analogico}}

% Tipo di carta intestata.
\def\uniud@intestazione{istituzionale}
\newcommand*{\uniudistituzionale}{\gdef\uniud@intestazione{istituzionale}}
\newcommand*{\uniuddipartimento}{\gdef\uniud@intestazione{dipartimento}}

\newcommand*{\uniud@headerboldtext}[1]{{\color{uniudblue}\uniudheaderbold\fontsize{8pt}{8pt}\selectfont #1}}
\newcommand*{\uniud@headerbooktext}[1]{{\color{uniudblue}\uniudheaderbook\fontsize{8pt}{8pt}\selectfont #1}}
\newcommand*{\uniud@bodyfont}{\fontsize{10pt}{12.5pt}\selectfont}
\newcommand*{\uniud@reffont}{\uniudheaderbook\fontsize{6pt}{7.5pt}\selectfont}
\newcommand*{\uniud@footerlabel}[1]{{\uniudheaderbold\fontsize{6pt}{7.5pt}\selectfont #1}}

\def\uniud@marchiofile{}
\newcommand*{\uniudsetmarchiodipartimento}[1]{\gdef\uniud@marchiofile{#1}}

% Marchio di dipartimento per la carta intestata.
% La costruzione e' espressa interamente nelle unita' del manuale:
%   sigillo/ingombro = 5.25 u
%   separazione      = 1.00 u
%   acronimo         = 4.80 u, centrato verticalmente
% L'unica misura assoluta e' l'ingombro complessivo (13 mm per il manuale).
% Modificando \uniud@deptmarkerheight tutte le altre misure scalano insieme.
\newlength{\uniud@deptmarkerheight}
\setlength{\uniud@deptmarkerheight}{13mm}
\newcommand*{\uniud@deptunit}{\dimexpr\uniud@deptmarkerheight*4/21\relax}
\newcommand*{\uniud@deptsealsize}{\dimexpr\uniud@deptunit*21/4\relax}
\newcommand*{\uniud@deptgap}{\uniud@deptunit}
\newcommand*{\uniud@deptacronymheight}{\dimexpr\uniud@deptunit*24/5\relax}
% (5.25u - 4.80u) / 2 = 0.225u = 9/40u.
\newcommand*{\uniud@deptacronymraise}{\dimexpr\uniud@deptunit*9/40\relax}

\newcommand*{\uniud@acronimodipartimento}{%
  \raisebox{\uniud@deptacronymraise}{%
    \resizebox{!}{\uniud@deptacronymheight}{%
      {\normalfont\upshape\color{uniudblue}\uniudacronymfont\usekomavar{acronimodipartimento}}%
    }%
  }%
}
\newcommand*{\uniud@marchiodipartimento}{%
  \ifx\uniud@marchiofile\@empty
    \raisebox{0pt}[\uniud@deptmarkerheight][0pt]{%
      \uniud@includeseal[width=\uniud@deptsealsize,height=\uniud@deptsealsize]%
      \hspace{\uniud@deptgap}%
      \uniud@acronimodipartimento
    }%
  \else
    \includegraphics[height=\uniud@deptmarkerheight]{\uniud@marchiofile}%
  \fi
}
% Wordmark UNIUD della prima pagina istituzionale.
\newcommand*{\uniud@wordmark}{%
  \resizebox{!}{10mm}{{\normalfont\upshape\color{uniudblue}\uniudwordmarkfont UNIUD}}%
}

% Logo contratto del 'segue foglio'. Viene composto tipograficamente dal
% package (come l'acronimo di dipartimento), evitando un ulteriore asset.
% Il manuale prescrive una larghezza complessiva di 21,3 mm; il rapporto
% interno tra UNI e UD resta quindi invariato anche se cambia il font di
% fallback, poiche' l'intero blocco viene ridimensionato come un'unita'.
\newcommand*{\uniud@continuationwordmark}{%
  \resizebox{21.3mm}{!}{%
    \vbox{%
      \offinterlineskip
      \hbox{{\normalfont\upshape\color{uniudblue}\uniudwordmarkfont UNI}}%
      \hbox{{\normalfont\upshape\color{uniudblue}\uniudwordmarkfont UD}}%
    }%
  }%
}
\newcommand*{\uniud@headrule}[2]{%
  \draw[line width=1pt,color=uniudblue]
    ([xshift=#1,yshift=-12mm]current page.north west) --
    ([xshift=#2,yshift=-12mm]current page.north west);%
}

% Nelle lettere di dipartimento il blocco protocollo/riferimenti e' opzionale.
% Se nessun campo di protocollo e' stato impostato, il blocco viene omesso senza
% riservare spazio. Nelle lettere istituzionali rimane invece sempre presente.
\newcommand*{\uniud@ifshowreferenceblock}[2]{%
  \ifdefstring{\uniud@intestazione}{dipartimento}{%
    \Ifkomavarempty{protocollo}{%
      \Ifkomavarempty{titolo}{%
        \Ifkomavarempty{classe}{%
          \Ifkomavarempty{fascicolo}{#2}{#1}%
        }{#1}%
      }{#1}%
    }{#1}%
  }{#1}%
}

\setkomavar{firsthead}{%
  \begin{tikzpicture}[remember picture,overlay]
    \ifdefstring{\uniud@intestazione}{dipartimento}{%
      \node[anchor=north west,inner sep=0pt]
        at ([xshift=12mm,yshift=-12mm]current page.north west)
        {\uniud@marchiodipartimento};
      \uniud@headrule{107mm}{147mm}
      \uniud@headrule{155mm}{195mm}
      \node[anchor=north west,align=left,text width=40mm,inner sep=0pt]
        at ([xshift=107mm,yshift=-14mm]current page.north west)
        {\uniud@headerboldtext{\usekomavar{struttura}\\[3mm]\usekomavar{fromurl}}};
      % Il blocco indirizzo usa tutta la larghezza del filetto (40 mm).
      % 28 mm era troppo stretto e spezzava inutilmente indirizzi come
      % ``via delle Scienze 206'' nella carta intestata dipartimentale.
      \node[anchor=north west,align=left,text width=40mm,inner sep=0pt]
        at ([xshift=155mm,yshift=-14mm]current page.north west)
        {\uniud@headerbooktext{\usekomavar{fromaddress}}};
    }{%
      \node[anchor=north west,inner sep=0pt]
        at ([xshift=12mm,yshift=-12mm]current page.north west)
        {\uniud@wordmark};
      % Sigillo separato previsto dalla carta intestata istituzionale.
      \node[anchor=north west,inner sep=0pt]
        at ([xshift=12mm,yshift=-103mm]current page.north west)
        {\uniud@includeseal[height=18mm]};
      \uniud@headrule{123mm}{163mm}
      \uniud@headrule{171mm}{199mm}
      \node[anchor=north west,align=left,text width=40mm,inner sep=0pt]
        at ([xshift=123mm,yshift=-14mm]current page.north west)
        {\uniud@headerboldtext{\usekomavar{struttura}\\[3mm]\usekomavar{fromurl}}};
      \node[anchor=north west,align=left,text width=28mm,inner sep=0pt]
        at ([xshift=171mm,yshift=-14mm]current page.north west)
        {\uniud@headerbooktext{\usekomavar{fromaddress}}};
    }%

    \node[anchor=north west,align=left,text width=72mm,inner sep=0pt]
      at ([xshift=123mm,yshift=-54mm]current page.north west)
      {\uniud@bodyfont\usekomavar{toname}\\\usekomavar{toaddress}};

    \uniud@ifshowreferenceblock{%
      \ifdefstring{\uniud@modalita}{analogico}{%
        \node[anchor=north west,align=left,text width=52mm,inner sep=0pt]
          at ([xshift=60mm,yshift=-54mm]current page.north west)
          {\uniud@bodyfont
            \begin{tabular}{@{}l@{\hspace{5mm}}l@{}}
              Prot. & \usekomavar{protocollo}\\
              Tit.  & \usekomavar{titolo}\\
              cl.   & \usekomavar{classe}\\
              Fasc. & \usekomavar{fascicolo}
            \end{tabular}};
      }{%
        \node[anchor=north west,align=left,text width=52mm,inner sep=0pt]
          at ([xshift=60mm,yshift=-54mm]current page.north west)
          {\uniud@bodyfont
            \usekomavar{place}\\
            data del protocollo\\[5mm]
            Numero della\\
            Segnatura di protocollo};
      }%
    }{}%
  \end{tikzpicture}%
}

\setkomavar{nexthead}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Costruzione 'segue foglio': margini 12 mm e logo contratto UNI/UD
    % largo esattamente 21,3 mm come da manuale di identita' visiva.
    \node[anchor=north west,inner sep=0pt]
      at ([xshift=12mm,yshift=-12mm]current page.north west)
      {\uniud@continuationwordmark};
  \end{tikzpicture}%
}

\setkomavar{firstfoot}{%
  \ifdefstring{\uniud@footerprimapagina}{true}{%
    \begin{tikzpicture}[remember picture,overlay]
      % Le tre zone del footer sono indipendenti: marchio istituzionale,
      % riferimenti variabili e certificazioni.
      \ifdefstring{\uniud@footermarchio}{true}{%
        \node[anchor=south west,inner sep=0pt]
          at ([xshift=12mm,yshift=15mm]current page.south west)
          {\uniud@includeasset[height=15.2mm]{uniud-footer-istituzionale-blu.pdf}};
      }{}%
      \ifdefstring{\uniud@footercertificazioni}{true}{%
        \node[anchor=south east,inner sep=0pt]
          at ([xshift=-12mm,yshift=15mm]current page.south east)
          {\uniud@includeasset[width=23mm]{uniud-footer-certificazioni.pdf}};
      }{}%

      \ifdefstring{\uniud@footerriferimenti}{true}{%
        \node[anchor=south west,align=left,text width=112mm,inner sep=0pt]
          at ([xshift=60mm,yshift=14.2mm]current page.south west)
          {\uniud@reffont\uniud@footercompactspacing
           \Ifkomavarempty{piedipaginaprimapagina}{}{\usekomavar{piedipaginaprimapagina}\\}%
           \ifdefstring{\uniud@footerresponsabile}{true}{%
             \Ifkomavarempty{responsabileprocedimento}{}{\uniud@footerlabel{Responsabile del procedimento:}\uniud@footerfieldspace\usekomavar{responsabileprocedimento}\\}%
           }{}%
           \ifdefstring{\uniud@footercompilatore}{true}{%
             \Ifkomavarempty{compilatoreprocedimento}{}{\uniud@footerlabel{Compilatore del procedimento:}\uniud@footerfieldspace\usekomavar{compilatoreprocedimento}\\}%
           }{}%
           \uniud@footercontactrow
           \uniud@footerfiscalrow};
      }{}%
    \end{tikzpicture}%
  }{}%
}
\setkomavar{nextfoot}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Numero pagina del 'segue foglio': Work Sans Regular 8/8, formato '2 di X',
    % allineato a sinistra nella colonna destra del reticolo e a 15 mm dal fondo.
    % Il totale e' ricavato dal package lastpage e richiede almeno due compilazioni.
    \node[anchor=south west,inner sep=0pt,text=uniudblue]
      at ([xshift=176mm,yshift=15mm]current page.south west)
      {{\normalfont\fontsize{8pt}{8pt}\selectfont\thepage\ di \pageref{LastPage}}};
  \end{tikzpicture}%
}

\AtBeginLetter{\uniud@bodyfont}

\newcommand*{\bloccofirmauniud}{%
  \par\vspace{4mm}
  \usekomavar{ruolofirmatario}\\
  \usekomavar{signature}%
  \ifdefstring{\uniud@modalita}{digitale}{%
    \par\vspace{8mm}
    {\fontsize{6pt}{7.5pt}\selectfont\colorbox{yellow}{\underline{FIRMA DIGITALE}}}\par
    \vspace{5mm}
    {\fontsize{6pt}{7.5pt}\selectfont
    Documento informatico firmato digitalmente ai sensi del D.lgs. 82/2005 s.m.i. e norme collegate, il quale sostituisce il documento cartaceo e la firma autografa.}%
  }{}%
}

\makeatother
