    footer-compilatore .choice:,
    footer-compilatore / true .code:n = { \uniudsetfootercompilatore{true} },
    footer-compilatore / false .code:n = { \uniudsetfootercompilatore{false} },
    footer-indirizzo .choice:,
    footer-indirizzo / true .code:n = { \uniudsetfooterindirizzo{true} },
    footer-indirizzo / false .code:n = { \uniudsetfooterindirizzo{false} },
    footer-telefono .choice:,
    footer-telefono / true .code:n = { \uniudsetfootertelefono{true} },
    footer-telefono / false .code:n = { \uniudsetfootertelefono{false} },
    footer-fax .choice:,
