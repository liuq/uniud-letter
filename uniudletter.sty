\NewDocumentCommand \UniudSetup { m }
  {
    \keys_set:nn { uniud/setup } { #1 }
    \uniud_aggiorna_indirizzo_mittente:
  }

\NewDocumentCommand \UniudDestinatario { m }
  {
    \keys_set:nn { uniud/destinatario } { #1 }
    \uniud_aggiorna_destinatario:
  }

\NewDocumentCommand \UniudProtocollo { m }
  { \keys_set:nn { uniud/protocollo } { #1 } }

\NewDocumentCommand \UniudOggetto { m }
  { \setkomavar{subject}{#1} }

\NewDocumentCommand \UniudDigitale { }
  { \UniudSetup{documento=digitale} }

\NewDocumentCommand \UniudAnalogico { }
  { \UniudSetup{documento=analogico} }

\NewDocumentCommand \UniudIstituzionale { }
  { \UniudSetup{intestazione=istituzionale} }

\cs_new_protected:Npn \uniud_imposta_dipartimento:n #1
  {
    \str_case_e:nnF { \str_uppercase:f {#1} }
      {
        {DIUM}{\UniudSetup{intestazione=dipartimento,acronimo=DIUM,struttura={Dipartimento~di~Studi\\umanistici~e~del\\patrimonio~culturale}}}
        {DILL}{\UniudSetup{intestazione=dipartimento,acronimo=DILL,struttura={Dipartimento~di~Lingue~e\\letterature,\\comunicazione,~formazione\\e~società}}}
        {DMIF}{\UniudSetup{intestazione=dipartimento,acronimo=DMIF,struttura={Dipartimento~di~Scienze\\matematiche,~informatiche\\e~fisiche}}}
        {DPIA}{\UniudSetup{intestazione=dipartimento,acronimo=DPIA,struttura={Dipartimento~Politecnico~di\\ingegneria~e~architettura}}}
        {DIES}{\UniudSetup{intestazione=dipartimento,acronimo=DIES,struttura={Dipartimento~di~Scienze\\economiche~e~statistiche}}}
        {DEIS}{\PackageWarningNoLine{uniudletter}{Acronimo DEIS non corrente; uso DIES}\UniudSetup{intestazione=dipartimento,acronimo=DIES,struttura={Dipartimento~di~Scienze\\economiche~e~statistiche}}}
        {DISG}{\UniudSetup{intestazione=dipartimento,acronimo=DISG,struttura={Dipartimento~di~Scienze\\giuridiche}}}
        {DI4A}{\UniudSetup{intestazione=dipartimento,acronimo=DI4A,struttura={Dipartimento~di~Scienze\\agroalimentari,~ambientali\\e~animali}}}
        {DMED}{\UniudSetup{intestazione=dipartimento,acronimo=DMED,struttura={Dipartimento~di~Medicina}}}
      }
      {
        \PackageWarningNoLine{uniudletter}{Dipartimento '#1' non riconosciuto; uso l'acronimo cosi' come fornito}
        \UniudSetup{intestazione=dipartimento,acronimo={#1}}
      }
  }

\NewDocumentCommand \UniudDipartimento { m }
  { \uniud_imposta_dipartimento:n {#1} }

\NewDocumentCommand \UniudFirma { }
  { \bloccofirmauniud }

